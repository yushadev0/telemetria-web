# Prod — https://yusa.app/telemetria/ altında sunulur (nginx static + reverse proxy).
# Taban bir YOL öneki: fetch same-origin `/telemetria/api/...`'e, WS `wss://yusa.app/telemetria/ws/...`'e gider.
# nginx `/telemetria/api/` ve `/telemetria/ws/` konumlarını uvicorn'a proxy'ler → mixed-content ve CORS yok.
VITE_API_BASE_URL=/telemetria
VITE_WS_BASE_URL=/telemetria
