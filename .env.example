# Bu dosyayı `.env` olarak kopyalayıp değerleri kendi ortamınıza göre düzenleyin.
#
# API tabanı. Boş bırakılırsa istekler same-origin relative path'e gider (prod proxy senaryosu).
# Dev'de backend'i doğrudan hedefleyin:
VITE_API_BASE_URL=http://127.0.0.1:8000
#
# WebSocket tabanı. Boş bırakılırsa window.location'dan türetilir (http→ws, https→wss).
VITE_WS_BASE_URL=ws://127.0.0.1:8000
